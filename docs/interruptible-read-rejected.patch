+package transport
+
+import (
+	"io"
+	"runtime"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestIdleInterruptibleReadAllowsGC(t *testing.T) {
+	old := runtime.GOMAXPROCS(2)
+	defer runtime.GOMAXPROCS(old)
+	if !allowInterruptibleReads() {
+		t.Fatal("interruptible read not available")
+	}
+	started := make(chan struct{}, 2)
+	finished := make(chan error, 2)
+	peers := []*socket{}
+	for range 2 {
+		fds, e := syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_STREAM|syscall.SOCK_CLOEXEC, 0)
+		if e != nil {
+			t.Fatal(e)
+		}
+		reader := &socket{fd: fds[0], rawRead: true, shortReadGaps: 4}
+		writer := &socket{fd: fds[1]}
+		defer reader.Close()
+		defer writer.Close()
+		peers = append(peers, writer)
+		go func() {
+			runtime.LockOSThread()
+			defer runtime.UnlockOSThread()
+			started <- struct{}{}
+			var b [1]byte
+			_, e := io.ReadFull(reader, b[:])
+			finished <- e
+		}()
+	}
+	<-started
+	<-started
+	gcDone := make(chan struct{})
+	go func() {
+		for range 100 {
+			runtime.GC()
+		}
+		close(gcDone)
+	}()
+	select {
+	case <-gcDone:
+	case <-time.After(3 * time.Second):
+		t.Fatal("GC stalled behind idle raw read")
+	}
+	select {
+	case e := <-finished:
+		t.Fatalf("idle read returned: %v", e)
+	default:
+	}
+	for _, s := range peers {
+		if _, e := s.Write([]byte("x")); e != nil {
+			t.Fatal(e)
+		}
+	}
+	for range peers {
+		select {
+		case e := <-finished:
+			if e != nil {
+				t.Fatal(e)
+			}
+		case <-time.After(time.Second):
+			t.Fatal("read did not resume")
+		}
+	}
+}
